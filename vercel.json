{
  "version": 2,
  "services": {
    "api": {
      "builds": {
        "root": "backend"
      }
    },
    "web": {
      "builds": {
        "root": "frontend"
      },
      "framework": "vite"
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/(.*)", "destination": "/web" }
  ]
}