APP_PASSWORD=change-me
# Optional. Defaults to ../Business.xlsx and backend/config.json.
# BUSINESS_FILE=../Business.xlsx
# CONFIG_FILE=./config.json
# FRONTEND_ORIGIN=http://localhost:5173
# Optional S3-compatible storage for persistent workbook and attachments.
# S3_BUCKET=your-bucket
# S3_REGION=us-east-1
# S3_ENDPOINT_URL=https://your-s3-compatible-endpoint
# S3_ATTACHMENTS_PREFIX=business-manager/attachments
# Optional one-way sync to Google Sheets. Share the sheet with the service account email.
# GOOGLE_SERVICE_ACCOUNT_JSON={...}
# GOOGLE_SHEETS_SPREADSHEET_ID=your-spreadsheet-id